{
  "name": "noqood-website",
  "version": "1.0.0",
  "private": true,
  "description": "NOQOOD ERP corporate website, marketing platform and lead CRM. Independent of the ERP application.",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "start:prod": "tsx scripts/migrate.ts && next start -p ${PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "next": "14.2.35",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
