# ── NOQOOD website: environment template. Copy to .env (never commit .env). ──
# Public address of the website (used in links, sitemap, canonical URLs)
SITE_URL=https://www.noqoodapp.com
# Where the ERP application opens (the "Login to ERP" button). Until app.noqoodapp.com is ready this stays on the current address.
ERP_URL=https://www.noqoodapp.com

# Separate database file for marketing content and CRM leads. NEVER point this at the ERP database.
WEBSITE_DB=./data/noqood-website.db

# Secret used to sign sessions and form tokens: at least 32 random characters
SESSION_SECRET=

# Administrator created by `npm run admin:create` (use a strong password, at least 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notifications (optional until verified). Without SMTP the leads are still stored and shown in the CRM; the notification status says "not configured".
# The notification address is set in Admin → Settings (default noqooderp@gmail.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional bot protection (Cloudflare Turnstile). When both are set the forms require a valid token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional analytics (loaded only after the visitor accepts cookies). Leave empty to disable.
GA_MEASUREMENT_ID=
